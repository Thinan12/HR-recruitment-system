# Copy to .env for local development. On Railway, set these as service variables.

# Required in production (32+ random characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First administrator. Only used when no admin exists yet; after that,
# change the password from Settings in the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SQLite database file. On Railway this must be on the mounted volume.
DATABASE_PATH=./data/hr.db

# production = secure cookies, HTTPS redirect, HSTS
NODE_ENV=development

# Railway sets PORT automatically.
PORT=3000
